# --- required: Neon identity database ---
STOCKER_DB_URL=jdbc:postgresql://<neon-host>/<db>?sslmode=require
STOCKER_DB_USER=
STOCKER_DB_PASSWORD=

# --- required: one Neon database per service that needs a database (same host, role and password) ---
# Create a database in Neon (never a local Postgres) and point the service at it. Use the direct endpoint
# (host without "-pooler"): Flyway needs it.
STOCKER_NOTIFICATIONS_DB_URL=jdbc:postgresql://<neon-host>/notifications?sslmode=require

# --- required: shared JWT secret (min 32 bytes, identical for gateway + identity) ---
STOCKER_JWT_SECRET=

# --- optional (defaults shown) ---
STOCKER_CORS_ALLOWED_ORIGINS=http://localhost:5173
STOCKER_AUTH_COOKIE_SECURE=false
