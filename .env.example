# Copy to .env in the repo root (gitignored) and fill in. Never commit real values.
# Every variable docker-compose.yml reads is listed here.
# Neon only: there is no local Postgres in this stack.

# ===== REQUIRED =====

# Main Neon database (identity, catalog, inventory, pricing). Same Neon host and role for all databases.
STOCKER_DB_URL=jdbc:postgresql://<neon-host>/neondb?sslmode=require
STOCKER_DB_USER=
STOCKER_DB_PASSWORD=
# Neon: STOCKER_DB_URL may be the pooled endpoint (host contains "-pooler"). Neon recommends the DIRECT
# endpoint (same host without "-pooler") for migrations; optional precaution for Flyway. Not read by compose
# (the services read it from their own environment), listed for reference only.
# STOCKER_DB_MIGRATE_URL=jdbc:postgresql://<neon-direct-host>/<db>?sslmode=require

# Own Neon databases (same host/role/password as above, database name replaced). Create them in Neon first.
# Use the direct endpoint (host without "-pooler"): Flyway needs it.
STOCKER_SHOPPING_DB_URL=jdbc:postgresql://<neon-host>/shopping?sslmode=require
STOCKER_NOTIFICATIONS_DB_URL=jdbc:postgresql://<neon-host>/notifications?sslmode=require

# Shared JWT secret (at least 32 bytes), identical for gateway and identity.
STOCKER_JWT_SECRET=

# ===== OPTIONAL (defaults shown) =====

# Browser origin(s) allowed by the gateway (comma-separated). Frontend dev server default:
STOCKER_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Refresh-token cookie "Secure" flag: keep false for plain http://localhost.
STOCKER_AUTH_COOKIE_SECURE=false
# Shared secret for shopping -> gateway comparison pushes (must match on both sides; compose passes it to both).
# Left empty, compose uses a dev-only default.
STOCKER_INTERNAL_TOKEN=

# Expiry-notification scan (notifications). Manual-test friendly defaults below; production default is PT15M.
STOCKER_NOTIFICATIONS_SCAN_INTERVAL=PT30S
STOCKER_NOTIFICATIONS_SCAN_INITIAL_DELAY=PT10S

# Live price provider (pricing /search only; the smoke test never calls it). Empty key = no provider calls succeed.
STOCKER_FETCH_PROVIDER=spread
STOCKER_SPREAD_API_KEY=

# ===== SUPERMARKET CRAWL (pricing): OFF by default =====
# Every crawl is a live request to a supermarket: needs the owner's explicit approval first.
# STOCKER_INGEST_ENABLED=true     # start the scheduled crawl (and on-demand refresh)
# STOCKER_INGEST_DRY_RUN=false    # also store what it scrapes (default true: scrape + log only)
STOCKER_INGEST_ENABLED=false
STOCKER_INGEST_DRY_RUN=true
# STOCKER_INGEST_MAX_PAGES_PER_CHAIN_PER_DAY=140   # hard cap of page loads per chain per Auckland day (cron + on-demand + extra pages)
# STOCKER_INGEST_MAX_PAGES_PER_CATEGORY=8          # most pages (?pg=1..N) walked for one multi-page category
# STOCKER_INGEST_EXTRA_PAGES_RESERVE_PER_RUN=20    # budget held back for the further pages of multi-page categories
# STOCKER_INGEST_STAPLE_DISCOVERY_ENABLED=true     # add sitemap category pages matching staple keywords (unverified; dead ones are quarantined)
# STOCKER_INGEST_MAX_DISCOVERED_PAGES_PER_CHAIN=40
# Pace: random pause between two page loads of one chain. 20-40 s (avg 30 s => 140 pages ~ 70 min of pauses per chain).
# STOCKER_INGEST_PAGE_DELAY_MIN_MILLIS=20000
# STOCKER_INGEST_PAGE_DELAY_MAX_MILLIS=40000
# Slow one chain only (empty = shared value above): STOCKER_INGEST_{NEWWORLD,PAKNSAVE,WOOLWORTHS}_PAGE_DELAY_{MIN,MAX}_MILLIS
# Circuit breaker per chain: N consecutive blocked responses (429/403/503/captcha) stop the chain; no scheduled or on-demand
# load until the cool-down is over (doubles on each consecutive trip, capped; a larger Retry-After wins). In memory.
# STOCKER_INGEST_BREAKER_BLOCKED_THRESHOLD=3
# STOCKER_INGEST_BREAKER_COOLDOWN=PT6H
# STOCKER_INGEST_BREAKER_MAX_COOLDOWN=PT24H
