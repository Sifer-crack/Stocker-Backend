# --- required: Neon identity database ---
STOCKER_DB_URL=jdbc:postgresql://<neon-host>/<db>?sslmode=require
STOCKER_DB_USER=
STOCKER_DB_PASSWORD=

# --- required: shared JWT secret (min 32 bytes, identical for gateway + identity) ---
STOCKER_JWT_SECRET=

# --- optional (defaults shown) ---
STOCKER_CORS_ALLOWED_ORIGINS=http://localhost:5173
STOCKER_AUTH_COOKIE_SECURE=false

# --- shared secret for shopping -> gateway comparison pushes (must match on both sides) ---
STOCKER_INTERNAL_TOKEN=

# --- live price provider key, passed to the pricing container (Spread is the default provider) ---
STOCKER_SPREAD_API_KEY=
