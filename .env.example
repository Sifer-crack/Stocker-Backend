# Copy to .env (gitignored) and fill in the required values.
# Only gateway + identity read these; all other services use local infra
# defaults hardcoded in docker-compose.yml.

# --- required: Neon identity database ---
IDENTITY_DB_URL=jdbc:postgresql://<neon-host>/<db>?sslmode=require
IDENTITY_DB_USER=
IDENTITY_DB_PASSWORD=

# --- required: shared JWT secret (min 32 bytes, identical for gateway + identity) ---
STOCKER_JWT_SECRET=

# --- optional (defaults shown) ---
STOCKER_CORS_ALLOWED_ORIGINS=http://localhost:5173
STOCKER_AUTH_COOKIE_SECURE=false
