# Root compose env file
#
# Read ONLY by docker-compose.override.yml to run the Neon-backed
# gateway + identity stack locally. This file is gitignored.
# For per-service `bootRun` usage, see each service's .env.example.
#
# TIP: if any value contains `$`, escape it as `$$`, otherwise compose
# will try to interpolate it and silently mangle the value.

# ---------------------------------------------------------------------------
# Databases (Neon)
# ---------------------------------------------------------------------------
# Use the direct (non-pooled) Neon endpoint. sslmode=require is mandatory;
# Neon rejects unencrypted connections.
#
# STOCKER_DB_URL is the identity database. The shopping and notifications
# services use their own databases, configured via the two URLs below.
STOCKER_DB_URL=postgresql://<host>/<database>?sslmode=require
STOCKER_SHOPPING_DB_URL=postgresql://<host>/<shopping-database>?sslmode=require
STOCKER_NOTIFICATIONS_DB_URL=postgresql://<host>/<notifications-database>?sslmode=require

# Neon credentials, shared by all of the databases above.
STOCKER_DB_USER=
STOCKER_DB_PASSWORD=

# ---------------------------------------------------------------------------
# Authentication (identity + gateway)
# ---------------------------------------------------------------------------
# JWT signing secret. Minimum 32 bytes and MUST be identical for the
# gateway and identity, or tokens will not validate across services.
# Generate one with: openssl rand -base64 48
#
# Do not reuse a production secret here. Rotate before relying on this setup.
STOCKER_JWT_SECRET=

# Refresh-token cookie flag:
#   false -> local development over plain http
#   true  -> anything served over https
STOCKER_AUTH_COOKIE_SECURE=false

# Comma-separated list of allowed browser origins, e.g.
# http://localhost:3000,http://localhost:5173
STOCKER_CORS_ALLOWED_ORIGINS=

# Shared secret for service-to-service calls. Generate with:
# openssl rand -base64 32
STOCKER_INTERNAL_TOKEN=

# ---------------------------------------------------------------------------
# OAuth (GitHub)
# ---------------------------------------------------------------------------
# Absolute URLs used during the OAuth flow. These must match the callback
# URL registered in the GitHub OAuth app.
STOCKER_OAUTH_REDIRECT_URI=http://localhost:8080/oauth2/callback/github
STOCKER_OAUTH_SUCCESS_REDIRECT=http://localhost:3000/
STOCKER_OAUTH_FAILURE_REDIRECT=http://localhost:3000/login?error=oauth

# GitHub OAuth app credentials.
STOCKER_GITHUB_CLIENT_ID=
STOCKER_GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# External APIs (pricing / ingest)
# ---------------------------------------------------------------------------
# Stats NZ API key (pricing data).
STOCKER_STATSNZ_API_KEY=

# Spread (Woolworths product data) API key.
STOCKER_SPREAD_API_KEY=

# RapidAPI credentials. HOST and BASE_URL go together with the key.
STOCKER_RAPIDAPI_KEY=
STOCKER_RAPIDAPI_HOST=
STOCKER_RAPIDAPI_BASE_URL=
