# --- required: Neon identity database ---
STOCKER_DB_URL=jdbc:postgresql://<neon-host>/<db>?sslmode=require
STOCKER_DB_USER=
STOCKER_DB_PASSWORD=
# Neon: STOCKER_DB_URL may be the pooled endpoint (host contains "-pooler"). Neon recommends the DIRECT
# endpoint (same host without "-pooler") for migrations; optional precaution for pricing's Flyway.
# STOCKER_DB_MIGRATE_URL=jdbc:postgresql://<neon-direct-host>/<db>?sslmode=require

# --- required: shared JWT secret (min 32 bytes, identical for gateway + identity) ---
STOCKER_JWT_SECRET=

# --- optional (defaults shown) ---
STOCKER_CORS_ALLOWED_ORIGINS=http://localhost:5173
STOCKER_AUTH_COOKIE_SECURE=false

# --- shared secret for shopping -> gateway comparison pushes (must match on both sides) ---
STOCKER_INTERNAL_TOKEN=

# --- live price provider key, passed to the pricing container (Spread is the default provider) ---
STOCKER_SPREAD_API_KEY=

# --- supermarket crawl (pricing): OFF by default; every crawl is a live request to a supermarket ---
# STOCKER_INGEST_ENABLED=true     # start the scheduled crawl
# STOCKER_INGEST_DRY_RUN=false    # also store what it scrapes (default: scrape + log only)
