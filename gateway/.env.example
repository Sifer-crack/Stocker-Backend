# Gateway environment.
# Copy to `.env` and fill in real values. Never commit `.env`
# (already gitignored — only `.env.example` files are tracked).
#
# The gateway holds no database; it proxies /api/identity/** to identity
# and validates JWTs itself, so it shares the JWT secret and CORS origins.

# App port.
SERVER_PORT=8080

# JWT signing secret, min 32 bytes for HS256.
# MUST be identical in identity and gateway.
STOCKER_JWT_SECRET=dev-only-32-byte-minimum-secret-0123456789

# Frontend origin(s) allowed through the gateway with cookies (comma-separated).
# Must include every origin the UI is served from (dev server, preview, deployed site).
STOCKER_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Identity route target. Default (application.yml) is http://identity:8081,
# which resolves under docker-compose. Uncomment ONLY when running the
# gateway locally via ./gradlew :gateway:bootRun:
# SPRING_CLOUD_GATEWAY_SERVER_WEBFLUX_ROUTES_0_URI=http://localhost:8081
