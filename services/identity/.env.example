# Identity service environment.
# Copy to `.env` and fill in real values. Never commit `.env`
# (already gitignored — only `.env.example` files are tracked).
#
# The Neon `identity` database must already contain the `users` table
# (email, password_hash, first_name, last_name — no username column).
# Flyway stays OFF so the app never runs migrations against Neon.

# Neon Postgres JDBC URL. sslmode=require is mandatory — Neon rejects plain connections.
# Use the DIRECT (non-pooled) endpoint, one URL per database is not needed here:
# identity only uses the `identity` database.
STOCKER_DB_URL=jdbc:postgresql://ep-xxxxxx-xxxxxx.<region>.aws.neon.tech/identity?sslmode=require
STOCKER_DB_USER=<neon-role>
STOCKER_DB_PASSWORD=<neon-password>

# Must stay false: schema is managed directly in Neon, not by Flyway.
# (Relaxed binding for `spring.flyway.enabled`.)
SPRING_FLYWAY_ENABLED=false

# App port.
SERVER_PORT=8081

# JWT signing secret, min 32 bytes for HS256.
# MUST be identical in identity and gateway.
STOCKER_JWT_SECRET=dev-only-32-byte-minimum-secret-0123456789

# Refresh-token cookie flags.
# false for local http, true once served behind https.
STOCKER_AUTH_COOKIE_SECURE=false

# Frontend origin(s) allowed to call the API with cookies (comma-separated).
STOCKER_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Kafka (optional for auth flows; the consumer retries in the background if unreachable).
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
